{
  "manifest_version": 3,
  "name": "WeChat Article Translator",
  "version": "1.0",
  "description": "Translates WeChat articles directly inside the browser.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://mp.weixin.qq.com/*",
    "https://api.siliconflow.cn/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/s*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}